{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsepoint.example/schemas/test-design-output.schema.json",
  "title": "Sutra Test Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "artifactId",
    "artifactType",
    "producer",
    "createdAt",
    "status",
    "sourceAnalysis",
    "blockers",
    "assumptions",
    "featureFiles",
    "scenarios",
    "triage",
    "queuedTickets",
    "frameworkGaps"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1 },
    "artifactId": { "type": "string", "minLength": 1 },
    "artifactType": { "const": "test_design" },
    "producer": { "const": "sutra" },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "status": {
      "enum": ["ready", "partial", "needs_input", "blocked", "failed"]
    },
    "sourceAnalysis": { "$ref": "#/$defs/sourceAnalysis" },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "featureFiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/featureFile" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    },
    "triage": {
      "type": "array",
      "items": { "$ref": "#/$defs/triage" }
    },
    "queuedTickets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "frameworkGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/frameworkGap" }
    }
  },
  "$defs": {
    "sourceAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifactId", "schemaVersion"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "artifactId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": "1.0.0" }
      }
    },
    "featureFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactPath", "targetPath", "action", "ticketKeys", "scenarioIds"],
      "properties": {
        "artifactPath": { "type": "string", "minLength": 1 },
        "targetPath": {
          "type": "string",
          "pattern": "^src/test/resources/features/.+\\.feature$"
        },
        "action": { "enum": ["create", "append", "unchanged"] },
        "ticketKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "scenarioIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "coveredBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featurePath", "scenarioName", "assertionAnchor"],
      "properties": {
        "featurePath": {
          "type": "string",
          "pattern": "^src/test/resources/features/.+\\.feature$"
        },
        "scenarioName": { "type": "string", "minLength": 1 },
        "assertionAnchor": { "type": "string", "minLength": 1 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "ticketKey",
        "requirementIds",
        "testCaseIds",
        "featurePath"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^SC_[A-Z][A-Z0-9]+-[0-9]+_[0-9]{2,}$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["scenario", "scenario_outline"] },
        "ticketKey": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "testCaseIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "featurePath": { "type": "string", "minLength": 1 }
      }
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testCaseId",
        "ticketKey",
        "requirementIds",
        "automationCandidate",
        "priority",
        "frameworkReadiness",
        "disposition",
        "rationale",
        "scenarioIds"
      ],
      "properties": {
        "testCaseId": { "type": "string", "minLength": 1 },
        "ticketKey": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "automationCandidate": { "enum": ["yes", "no", "blocked", "duplicate"] },
        "priority": { "enum": ["high", "medium", "low"] },
        "frameworkReadiness": { "enum": ["ready", "gap"] },
        "disposition": { "enum": ["authored", "queued", "not_automatable", "blocked", "duplicate"] },
        "rationale": { "type": "string", "minLength": 1 },
        "scenarioIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "coveredBy": { "$ref": "#/$defs/coveredBy" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "duplicate" } },
            "required": ["disposition"]
          },
          "then": {
            "required": ["coveredBy"],
            "properties": {
              "automationCandidate": { "const": "duplicate" },
              "scenarioIds": { "maxItems": 0 }
            }
          },
          "else": {
            "not": { "required": ["coveredBy"] },
            "properties": {
              "automationCandidate": { "not": { "const": "duplicate" } }
            }
          }
        }
      ]
    },
    "frameworkGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticketKey", "description", "affectedScenarioIds"],
      "properties": {
        "ticketKey": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "affectedScenarioIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
